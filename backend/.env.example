# kabuka backend 環境変数のサンプル。`.env` にコピーして使う（.env はコミットしない）。

# EDINET API v2 のキー（無料登録: https://disclosure2.edinet-fsa.go.jp/）
# value/quality 用の履歴財務取得に使用。
KABUKA_EDINET_KEY=

# J-Quants API v2（Standardプラン）の本検証用。
# V2はAPIキー方式（メール/パスワードではない）。J-Quantsマイページ＞APIキーで発行。
KABUKA_JQUANTS_API_KEY=

# バックテストのパラメータ（未設定ならconfig.pyの既定値）
# KABUKA_START=2014-01-01
# KABUKA_END=2024-12-31
# KABUKA_COST_BPS=20
# KABUKA_QUANTILES=5
