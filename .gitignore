# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# 環境変数（APIキー等。リポジトリにコミットしない）
.env

# データキャッシュ（再取得可能なため追跡しない）
backend/data/*.parquet
# ただしライブ推奨ログは実時間の記録で再生成不可 → 追跡する
!backend/data/reco_log.parquet
# CIが毎回ゼロから10年分を取得しないよう、生データをシードとして同梱（差分更新の土台）
!backend/data/jq_prices.parquet
!backend/data/jq_statements.parquet
!backend/data/universe_membership.parquet
!backend/data/topix_index.parquet

# 認証トークンのキャッシュ（秘密。絶対にコミットしない）
backend/data/*.json
backend/data/jquants_token.json

# Claude Code のローカル個人設定（絶対パス等を含むため共有しない）
.claude/settings.local.json

# Pages用の生成物（CIで都度生成するため追跡しない）
web/data/
web/about.html
